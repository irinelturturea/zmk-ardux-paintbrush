#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

&pro_micro_i2c {
	status = "okay";

	oled: ssd1306@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		label = "DISPLAY";
		width = <128>;
		height = <32>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <31>;
		segment-remap;
		com-invdir;
		com-sequential;
		prechargep = <0x22>;
		inversion-on;
	};
};

/ {
	chosen {
		zmk,kscan = &kscan0;
		zephyr,display = &oled;
		zmk,physical-layout = &physical_layout0;
	};

	kscan0: kscan_0 {
		compatible = "zmk,kscan-gpio-direct";

		label = "KSCAN";

		input-gpios
			= <&pro_micro_a 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&pro_micro_a 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&pro_micro_a 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&pro_micro_a 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&pro_micro_d 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&pro_micro_d 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&pro_micro_d 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&pro_micro_d 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			;

	};

	/*
	 * kscan-gpio-direct reports every input as row 0 / column <input index>,
	 * so the transform below is a straight 1:1 map: keymap position N is the
	 * N-th entry of input-gpios above.
	 */
	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <8>;
		rows = <1>;

		map = <
			RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)
		>;
	};

	/*
	 * Required for ZMK Studio builds. The right half is normally built
	 * without Studio, but the layout is defined here too so both halves can
	 * be built with -DCONFIG_ZMK_STUDIO=y if needed.
	 */
	physical_layout0: physical_layout_0 {
		compatible = "zmk,physical-layout";
		display-name = "Paintbrush Right";

		transform = <&default_transform>;

		keys  //                     w   h    x    y   rot  rx  ry
			= <&key_physical_attrs 100 100   0    0   0   0   0>
			, <&key_physical_attrs 100 100 100    0   0   0   0>
			, <&key_physical_attrs 100 100 200    0   0   0   0>
			, <&key_physical_attrs 100 100 300    0   0   0   0>
			, <&key_physical_attrs 100 100   0  100   0   0   0>
			, <&key_physical_attrs 100 100 100  100   0   0   0>
			, <&key_physical_attrs 100 100 200  100   0   0   0>
			, <&key_physical_attrs 100 100 300  100   0   0   0>
			;
	};
};
